{"id":"santa-fe","label":"Santa Fe","region":"Santa Fe","checked":"Nov 13, 2026","work":[{"id":"sf1","region":"Santa Fe","area":"Cerrillos Road","name":"Iconik Coffee Roasters – Red","type":"Coffee shop","setting":"Indoor + patio","address":"1366 Cerrillos Rd, Santa Fe, NM 87505","lat":35.670469,"lng":-105.964528,"vibe":"Locals' favorite for remote work, like a cozy coworking space: the most natural light of the three Iconiks, cushy sofas and standing desks. Plugs are limited.","wifi":"Limited plugs","hours":"","url":"https://shop.iconikcoffee.com/","phone":"","source":"https://honeygouda.travel.blog/2026/05/29/best-coffee-shops-with-wi-fi-in-santa-fe-nm/","sourceName":"Honey Gouda","kind":"work"},{"id":"sf2","region":"Santa Fe","area":"Lena Street","name":"Iconik Coffee Roasters – Lena","type":"Coffee shop","setting":"Indoor","address":"1600 Lena St, Santa Fe, NM 87505","lat":35.66562,"lng":-105.963373,"vibe":"A roomy industrial space that's great on a winter day; a Workfrom reviewer found it full of people working, with mellow music and outlets along the walls. Get there early.","wifi":"Outlets along the walls (Workfrom review)","hours":"","url":"https://shop.iconikcoffee.com/","phone":"","source":"https://honeygouda.travel.blog/2026/05/29/best-coffee-shops-with-wi-fi-in-santa-fe-nm/","sourceName":"Honey Gouda","kind":"work"},{"id":"sf3","region":"Santa Fe","area":"Railyard / Downtown","name":"Iconik Coffee Roasters – Lupe","type":"Coffee shop","setting":"Indoor + patio","address":"314 S Guadalupe St, Santa Fe, NM 87501","lat":35.685987,"lng":-105.945249,"vibe":"The Iconik with the best outdoor seating, ideal in summer; it shares a building with the Co-Fe coworking space.","wifi":"","hours":"","url":"https://shop.iconikcoffee.com/","phone":"","source":"https://honeygouda.travel.blog/2026/05/29/best-coffee-shops-with-wi-fi-in-santa-fe-nm/","sourceName":"Honey Gouda","kind":"work"},{"id":"sf4","region":"Santa Fe","area":"Downtown","name":"La Mama","type":"Café","set